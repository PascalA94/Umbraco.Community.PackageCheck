<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Libraries are bundled into the tool, never published on their own (design 7.1). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Spike S4 (GO): reads .sln and .slnx without hand-rolled parsing. -->
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <InternalsVisibleTo Include="PackageCheck.Inputs.Tests" />
    <ProjectReference Include="../PackageCheck.Core/PackageCheck.Core.csproj" />
  </ItemGroup>
</Project>
