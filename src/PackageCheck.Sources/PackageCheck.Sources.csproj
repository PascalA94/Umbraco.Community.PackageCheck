<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Libraries are bundled into the tool, never published on their own (design 7.1). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PackageCheck.Core/PackageCheck.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" />
    <!-- Override files are YAML (design 7.8); JSON is read by the same parser, YAML being a superset. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bundled data snapshot (design 7.8): data/ at the repo root. overrides.seed.json is generated from overrides/ by tools/compile.cs (its seed option), and CI checks it is in sync. -->
    <EmbeddedResource Include="../../data/umbraco-versions.json" LogicalName="PackageCheck.Data.umbraco-versions.json" />
    <EmbeddedResource Include="../../data/overrides.seed.json" LogicalName="PackageCheck.Data.overrides.seed.json" />
  </ItemGroup>
</Project>
