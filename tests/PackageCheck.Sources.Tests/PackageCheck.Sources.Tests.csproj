<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PackageCheck.Sources/PackageCheck.Sources.csproj" />
    <!-- Built alongside so the two-process cache test can start it (Review Focus 5). -->
    <ProjectReference Include="../Support/CacheHammer/CacheHammer.csproj" />
    <Compile Include="../Support/NupkgBuilder.cs" LinkBase="Support" />
    <!-- Shared helpers and recorded HTTP live in tests/Support (ruling R14). -->
    <Compile Include="../Support/FixtureHttpHandler.cs" LinkBase="Support" />
    <Content Include="../Support/Http/**" LinkBase="Http" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
