<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PackageCheck.Report/PackageCheck.Report.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Approved snapshots are read from the output, since CI builds map source paths away (Snapshot.cs). -->
    <None Include="Snapshots/*.verified.*" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots" />
  </ItemGroup>
</Project>
